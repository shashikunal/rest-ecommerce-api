# ===========================================
# Environment Configuration
# Copy .env.example to .env and fill in values
# NEVER commit .env to version control
# ===========================================

# Application
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# MongoDB Atlas
MONGODB_URI=mongodb://localhost:27017/rest-mock-apis-dev
MONGODB_TEST_URI=mongodb://localhost:27017/rest-mock-apis-test

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=rest-mock-apis
KAFKA_GROUP_ID=rest-mock-apis-group
KAFKA_USERNAME=
KAFKA_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change-me-in-production-at-least-256-bits
JWT_REFRESH_SECRET=change-me-in-production-at-least-256-bits

# Token TTLs
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
MAX_SESSIONS_PER_USER=10
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION_MS=900000
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128

# SMTP (Mailpit for local)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=debug

# OpenAPI
SWAGGER_ENABLED=true

# Idempotency
IDEMPOTENCY_TTL=86400

# Rate Limiting
RATE_LIMITER_REDIS_TTL=60

# Feature Flags
FEATURE_SWAGGER_UI=true
FEATURE_DEBUG_ENDPOINTS=false
